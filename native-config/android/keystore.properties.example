# BWP Billing - release signing.
# 1. Copy this file to  android/keystore.properties
# 2. Fill in your own values.
# 3. NEVER commit keystore.properties or the .jks file, and keep a safe backup of both.
#
# storeFile is relative to the android/ folder.
storeFile=bwp-billing-release.jks
storePassword=CHANGE_ME
keyAlias=bwp-billing
keyPassword=CHANGE_ME
