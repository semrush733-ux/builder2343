<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Needed so the page (navigator.onLine) and the app know whether the phone is online. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- CAMERA permission is intentionally NOT declared: photos for uploads are taken with the
         phone's own camera app, which needs no permission in this app. -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <!-- HTTPS only, system certificate authorities only (see res/xml/bwp_network_security_config.xml). -->
    <application android:networkSecurityConfig="@xml/bwp_network_security_config">
        <provider
            android:name="com.bwpexperts.billing.nativeplugin.BwpFileProvider"
            android:authorities="${applicationId}.bwpfiles"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/bwp_file_paths" />
        </provider>
    </application>
</manifest>
